<phpunit bootstrap="tests/bootstrap.php">
    <testsuites>
        <testsuite name="FederationJevGuard Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="error_reporting" value="-1"/>

        <!-- ncc configuration -->
        <env name="NCC_DISABLE_APCU" value="1"/>

        <!-- Federation Server configuration -->
        <env name="SERVER_ENDPOINT" value="http://172.17.0.1:7000"/>
        <env name="SERVER_ACCESS_TOKEN" value="abcdefghijklmnopqrstuvwxyz123456"/>
        <!-- The mock System One endpoint's request log, see tests/mock-systemone -->
        <env name="MOCK_SYSTEMONE_ENDPOINT" value="http://172.17.0.1:7080"/>
        <!-- Runs a maintenance run of the test environment's server, the integration tests' reviews are made by it.
             Defaults to `docker compose -f docker-compose.yml exec -T app federationlib maintenance` -->
        <env name="JEVGUARD_MAINTENANCE_COMMAND" value=""/>

        <!-- A live System One endpoint for the live tests (group live), they're skipped without one. An environment
             variable that is already set takes precedence, eg; JEVGUARD_LIVE_ENDPOINT=https://api.typesafe.ai/v1/systemone -->
        <env name="JEVGUARD_LIVE_ENDPOINT" value=""/>
        <env name="JEVGUARD_LIVE_API_KEY" value=""/>
        <env name="JEVGUARD_LIVE_MODEL" value=""/>
        <env name="JEVGUARD_LIVE_CONTEXT_TOKENS" value=""/>
        <env name="JEVGUARD_LIVE_IMAGES" value=""/>

        <!-- LogLib2 configuration -->
        <env name="LOG_LEVEL" value="debug"/>
        <env name="LOGLIB_CONSOLE_ENABLED" value="false"/>
        <env name="LOGLIB_UDP_ENABLED" value="true"/>
        <env name="LOGLIB_UDP_HOST" value="127.0.0.1"/>
        <env name="LOGLIB_UDP_PORT" value="5000"/>
        <env name="LOGLIB_UDP_TRACE_FORMAT" value="full"/>
    </php>
</phpunit>
